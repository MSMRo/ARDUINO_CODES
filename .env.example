# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arduino_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# SQLAlchemy Database URL (Defaults to PostgreSQL, can use sqlite:///./arduino_fallback.db for quick development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/arduino_db

# FastAPI Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_STR=/api/v1

# Streamlit Frontend Settings
FASTAPI_BASE_URL=http://127.0.0.1:8000
